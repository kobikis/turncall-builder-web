server {
    listen 80;
    root /usr/share/nginx/html;

    # /api/x -> ${BUILDER_API_URL}/x, as vite.config.ts rewrites it in dev.
    location /api/ {
        proxy_pass ${BUILDER_API_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A Builder turn streams and can think for minutes.
        proxy_buffering off;
        proxy_read_timeout 600s;
        client_max_body_size 25m;
    }

    # Client-side routes: every other path is the app.
    location / {
        try_files $uri /index.html;
    }
}
